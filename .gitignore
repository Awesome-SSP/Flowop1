# Root .gitignore for the Flowop monorepo

# Node modules
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
dist/
build/
frontend/dist/
frontend/build/

# Vite
.vite/
frontend/.vite/

# Environment files
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# TypeScript
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# Caches and misc
.cache/
.cache-loader/
logs/
*.tgz
